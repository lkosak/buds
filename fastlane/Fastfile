default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
    )

    # Use the GitHub Actions run number as the build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "Buds.xcodeproj",
    )

    gym(
      scheme: "Buds",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath '#{ENV["ASC_KEY_PATH"]}'",
        "-authenticationKeyID '#{ENV["APP_STORE_CONNECT_KEY_ID"]}'",
        "-authenticationKeyIssuerID '#{ENV["APP_STORE_CONNECT_ISSUER_ID"]}'",
        "DEVELOPMENT_TEAM='#{ENV["DEVELOPMENT_TEAM"]}'",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "CODE_SIGN_STYLE=Automatic",
      ].join(" "),
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
